package diagnostics;

struct Utf16Checkpoint {
    offset: isize,
    column: isize,
}

pub struct Utf16Index {
    source: Source,
    points: Vec[Utf16Checkpoint],
    line_starts: Vec[isize],
}

fn scalar_bytes(value: char) -> isize {
    let code = value.to_u32();
    if code <= 127 {
        1
    } else if code <= 2047 {
        2
    } else if code <= 65535 {
        3
    } else {
        4
    }
}

impl Source {
    pub fn utf16_index(self: Source) -> Utf16Index {
        let points = Vec::new();
        let line_starts = Vec::new();
        for line in self.lines {
            line_starts.push(points.len());
            points.push(Utf16Checkpoint { offset: line.start, column: 0 });
            let mut offset = line.start;
            let mut column = 0;
            let mut scalars = 0;
            for value in line.text.chars() {
                offset += scalar_bytes(value);
                column += if value.to_u32() > 65535 {
                    2
                } else {
                    1
                };
                scalars += 1;
                if scalars % 64 == 0 {
                    points.push(Utf16Checkpoint { offset, column });
                }
            }
            if points[points.len() - 1].offset != offset {
                points.push(Utf16Checkpoint { offset, column });
            }
        }
        line_starts.push(points.len());
        Utf16Index { source: self, points, line_starts }
    }
}

impl Utf16Index {
    fn checkpoint(self: Utf16Index, line: isize, position: isize, bytes: bool) -> isize {
        let mut low = self.line_starts[line];
        let mut high = self.line_starts[line + 1];
        while low + 1 < high {
            let mid = low + (high - low) / 2;
            let current = if bytes {
                self.points[mid].offset
            } else {
                self.points[mid].column
            };
            if current <= position {
                low = mid;
            } else {
                high = mid;
            }
        }
        low
    }

    pub fn location(self: Utf16Index, offset: isize) -> Result[Utf16Location, Error] {
        self.source.span(offset, offset)?;
        let number = line_at(self.source, offset);
        let line = self.source.lines[number];
        let offset = minimum(offset, line.end);
        let point = self.points[self.checkpoint(number, offset, true)];
        let mut column = point.column;
        for scalar in self.source.text.byte_slice(point.offset, offset).chars() {
            column += if scalar.to_u32() > 65535 {
                2
            } else {
                1
            };
        }
        Result::Ok(Utf16Location { line: number, column })
    }

    pub fn offset(self: Utf16Index, line: isize, column: isize) -> Result[isize, Error] {
        let invalid = Error::InvalidUtf16Location { line, column };
        if column < 0 {
            return Result::Err(invalid);
        }
        let Some(source_line) = self.source.line(line) else {
            return Result::Err(invalid);
        };
        let index = self.checkpoint(line, column, false);
        let point = self.points[index];
        let end = if index + 1 < self.line_starts[line + 1] {
            self.points[index + 1].offset
        } else {
            source_line.end
        };
        let mut offset = point.offset;
        let mut used = point.column;
        for scalar in self.source.text.byte_slice(offset, end).chars() {
            if used == column {
                return Result::Ok(offset);
            }
            used += if scalar.to_u32() > 65535 {
                2
            } else {
                1
            };
            if used > column {
                return Result::Err(invalid);
            }
            offset += scalar_bytes(scalar);
        }
        if used == column {
            Result::Ok(offset)
        } else {
            Result::Err(invalid)
        }
    }
}
